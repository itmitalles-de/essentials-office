{
  "$schema": "./schemas/office-modules.schema.json",
  "contractVersion": "2.0.0",
  "schemaVersion": "1.0.0",
  "product": {
    "id": "essentialsplus-office",
    "displayName": "Essentials+ Office",
    "brand": "Essentials Plus"
  },
  "states": [
    "not_installed",
    "needs_configuration",
    "disabled",
    "enabled",
    "degraded"
  ],
  "groups": [
    {"id": "files-groupware", "displayName": "Dateien und Groupware", "order": 10},
    {"id": "intranet-knowledge", "displayName": "Intranet und Wissen", "order": 20},
    {"id": "documents", "displayName": "Dokumente", "order": 30},
    {"id": "communication", "displayName": "Kommunikation", "order": 40},
    {"id": "security", "displayName": "Sicherheit", "order": 50},
    {"id": "people-hr", "displayName": "People und HR", "order": 60},
    {"id": "integrations", "displayName": "Integrationen", "order": 70},
    {"id": "custom", "displayName": "Kundenspezifisch", "order": 80}
  ],
  "adminCenter": {
    "ownerGroup": "admin",
    "auditRetentionEntries": 1000,
    "userVisibilityRule": "Only modules with active=true, a fresh successful health check and matching group entitlement are shown to non-administrators.",
    "externalActivationRule": "A desired external module state never controls its service. Logical activation follows only after configuration and a successful health check."
  },
  "modules": [
    {
      "id": "nextcloud-core",
      "version": "1.0.0",
      "group": "files-groupware",
      "displayName": "Dateien und Groupware",
      "description": "Kanonischer Kern für Dateien, Kalender, Kontakte, Aufgaben und Notizen.",
      "type": "nextcloud-core",
      "required": true,
      "defaultState": "enabled",
      "dependencies": [],
      "conflicts": [],
      "compatibility": {
        "nextcloud": {"min": "34.0.0", "maxExclusive": "35.0.0"},
        "apps": {"schema": "1.x"},
        "manifestSchema": "1.0.0"
      },
      "configuration": {"requirements": []},
      "secrets": {"requirements": [], "handling": "Host-local Nextcloud secrets only; never exposed by the Admin Center."},
      "groups": {"default": ["all-authenticated"], "allowed": ["all-authenticated"], "autoCreate": false},
      "roles": ["admin", "user"],
      "nextcloudApps": [
        {"id": "files", "required": true, "source": "shipped", "minVersion": "2.0.0", "maxExclusive": "3.0.0"},
        {"id": "calendar", "required": true, "source": "app-store", "minVersion": "6.0.0", "maxExclusive": "8.0.0"},
        {"id": "contacts", "required": true, "source": "app-store", "minVersion": "8.0.0", "maxExclusive": "10.0.0"},
        {"id": "tasks", "required": true, "source": "app-store", "minVersion": "0.17.0", "maxExclusive": "1.0.0"},
        {"id": "notes", "required": true, "source": "app-store", "minVersion": "4.12.0", "maxExclusive": "7.0.0"},
        {"id": "essentialsplus", "required": true, "source": "repository", "minVersion": "1.0.0", "maxExclusive": "2.0.0"}
      ],
      "composeServices": ["app", "cron", "db", "redis"],
      "externalServices": [],
      "jobs": ["Nextcloud cron", "Essentials+ module health reconciliation"],
      "webhooks": [],
      "healthcheck": {"kind": "nextcloud", "cacheSeconds": 300, "expectedStatuses": []},
      "dataOwnership": {"owner": "Nextcloud", "stores": ["PostgreSQL", "/srv/nextcloud/html", "/srv/nextcloud/data"], "sharedDatabase": false},
      "backup": {"boundary": "Nextcloud backup", "includes": ["logical PostgreSQL dump", "code", "config", "apps", "themes", "data"]},
      "restore": {"boundary": "Empty isolated Nextcloud target", "preservesDataOnDisable": true},
      "export": {"format": "WebDAV and supported Nextcloud exports", "available": true},
      "activation": {"mode": "required", "requiresHealthy": true, "hostControl": false},
      "deactivation": {"allowed": false, "deletesData": false, "stopsService": false},
      "update": {"policy": "Minor and patch within Nextcloud 34 only", "rollback": "Restore the pre-update backup on an empty target"}
    },
    {
      "id": "intranet-lite",
      "version": "1.0.0",
      "group": "intranet-knowledge",
      "displayName": "Intranet Lite",
      "description": "Aktuelles, Handbuch, Prozesse, Ansprechpartner, FAQ, Vorlagen und Links mit Nextcloud-eigenen Bausteinen.",
      "type": "nextcloud-composite",
      "required": false,
      "defaultState": "disabled",
      "dependencies": ["nextcloud-core"],
      "conflicts": [],
      "compatibility": {"nextcloud": {"min": "34.0.0", "maxExclusive": "35.0.0"}, "apps": {"schema": "1.x"}, "manifestSchema": "1.0.0"},
      "configuration": {"requirements": []},
      "secrets": {"requirements": [], "handling": "No module-specific secret."},
      "groups": {"default": ["intranet-editor", "employee"], "allowed": ["intranet-editor", "employee", "manager"], "autoCreate": true},
      "roles": ["admin", "editor", "reader"],
      "nextcloudApps": [
        {"id": "collectives", "required": true, "source": "app-store", "minVersion": "4.0.0", "maxExclusive": "5.0.0", "visibilityMode": "platform-global"},
        {"id": "circles", "required": true, "source": "shipped", "minVersion": "34.0.0", "maxExclusive": "35.0.0", "visibilityMode": "platform-global"},
        {"id": "dashboard", "required": true, "source": "shipped", "minVersion": "7.0.0", "maxExclusive": "9.0.0"},
        {"id": "announcementcenter", "required": true, "source": "app-store", "minVersion": "7.0.0", "maxExclusive": "9.0.0", "visibilityMode": "platform-global"},
        {"id": "forms", "required": true, "source": "app-store", "minVersion": "5.0.0", "maxExclusive": "6.0.0", "visibilityMode": "platform-global"},
        {"id": "tables", "required": true, "source": "app-store", "minVersion": "2.0.0", "maxExclusive": "3.0.0"},
        {"id": "deck", "required": true, "source": "app-store", "minVersion": "1.0.0", "maxExclusive": "2.0.0"}
      ],
      "composeServices": [],
      "externalServices": [],
      "jobs": ["Nextcloud cron"],
      "webhooks": [],
      "healthcheck": {"kind": "nextcloud-apps", "cacheSeconds": 300, "expectedStatuses": []},
      "dataOwnership": {"owner": "Nextcloud", "stores": ["Nextcloud PostgreSQL", "Nextcloud files"], "sharedDatabase": false},
      "backup": {"boundary": "Nextcloud backup", "includes": ["Collectives and app data", "protected files"]},
      "restore": {"boundary": "Nextcloud restore", "preservesDataOnDisable": true},
      "export": {"format": "Collectives/files export", "available": true},
      "activation": {"mode": "admin-center", "requiresHealthy": true, "hostControl": false},
      "deactivation": {"allowed": true, "deletesData": false, "stopsService": false},
      "update": {"policy": "Compatible App Store releases only", "rollback": "Disable the module and restore the pre-update Nextcloud backup if schema changes cannot be reversed"}
    },
    {
      "id": "collabora",
      "version": "1.0.0",
      "group": "documents",
      "displayName": "Collabora Online",
      "description": "Getrennter Office-Service für browserbasierte Dokumentbearbeitung über WOPI.",
      "type": "external-service",
      "required": false,
      "defaultState": "not_installed",
      "dependencies": ["nextcloud-core"],
      "conflicts": [],
      "compatibility": {"nextcloud": {"min": "34.0.0", "maxExclusive": "35.0.0"}, "apps": {"schema": "1.x"}, "manifestSchema": "1.0.0"},
      "configuration": {"requirements": [
        {"key": "installed", "type": "boolean", "required": true},
        {"key": "serviceUrl", "type": "https-url", "required": true},
        {"key": "healthUrl", "type": "https-url", "required": true},
        {"key": "wopiReady", "type": "attestation", "required": true}
      ]},
      "secrets": {"requirements": [], "handling": "WOPI allowlists remain in controlled host/Nextcloud configuration."},
      "groups": {"default": ["employee"], "allowed": ["employee", "manager", "hr-admin"], "autoCreate": true},
      "roles": ["admin", "editor"],
      "nextcloudApps": [{"id": "richdocuments", "required": true, "source": "app-store", "minVersion": "11.0.0", "maxExclusive": "12.0.0"}],
      "composeServices": ["collabora"],
      "externalServices": [{"id": "collabora", "dataShared": "WOPI file access only", "sharesDatabase": false, "sharesSecrets": false}],
      "jobs": [],
      "webhooks": [],
      "healthcheck": {"kind": "https", "endpointConfigurationKey": "healthUrl", "allowedHostSuffixes": [".itmitalles.de", ".internal"], "cacheSeconds": 300, "expectedStatuses": [200]},
      "dataOwnership": {"owner": "Nextcloud for files; Collabora for transient sessions", "stores": ["Nextcloud files"], "sharedDatabase": false},
      "backup": {"boundary": "Nextcloud files only", "includes": ["documents and richdocuments configuration"]},
      "restore": {"boundary": "Restore Nextcloud independently; redeploy Collabora", "preservesDataOnDisable": true},
      "export": {"format": "Original office documents", "available": true},
      "activation": {"mode": "admin-center-after-compose", "requiresHealthy": true, "hostControl": false},
      "deactivation": {"allowed": true, "deletesData": false, "stopsService": false},
      "update": {"policy": "Exact reviewed image tag and digest", "rollback": "Restore previous image pin and Nextcloud configuration"}
    },
    {
      "id": "talk",
      "version": "1.0.0",
      "group": "communication",
      "displayName": "Talk",
      "description": "Nextcloud Talk P2P; TURN und HPB bleiben getrennte optionale Stufen.",
      "type": "nextcloud-composite",
      "required": false,
      "defaultState": "disabled",
      "dependencies": ["nextcloud-core"],
      "conflicts": [],
      "compatibility": {"nextcloud": {"min": "34.0.0", "maxExclusive": "35.0.0"}, "apps": {"schema": "1.x"}, "manifestSchema": "1.0.0"},
      "configuration": {"requirements": []},
      "secrets": {"requirements": [{"id": "turn-shared-secret", "required": false, "source": "root-only host file"}], "handling": "The Admin Center stores only a readiness attestation, never the TURN secret."},
      "groups": {"default": ["employee"], "allowed": ["employee", "manager", "hr-admin"], "autoCreate": true},
      "roles": ["admin", "participant", "moderator"],
      "nextcloudApps": [{"id": "spreed", "required": true, "source": "app-store", "minVersion": "24.0.0", "maxExclusive": "25.0.0"}],
      "composeServices": ["turn"],
      "externalServices": [{"id": "turn", "optional": true, "sharesDatabase": false, "sharesSecrets": false}],
      "jobs": ["Nextcloud cron"],
      "webhooks": [],
      "healthcheck": {"kind": "nextcloud-apps", "cacheSeconds": 300, "expectedStatuses": []},
      "dataOwnership": {"owner": "Nextcloud", "stores": ["Nextcloud PostgreSQL", "Nextcloud files"], "sharedDatabase": false},
      "backup": {"boundary": "Nextcloud backup", "includes": ["rooms", "messages", "shared files", "Talk configuration"]},
      "restore": {"boundary": "Nextcloud restore; TURN is redeployed separately", "preservesDataOnDisable": true},
      "export": {"format": "Supported Nextcloud/Talk export", "available": true},
      "activation": {"mode": "admin-center", "requiresHealthy": true, "hostControl": false},
      "deactivation": {"allowed": true, "deletesData": false, "stopsService": false},
      "update": {"policy": "Compatible Talk app release; TURN exact image pin", "rollback": "Disable logical activation and restore the pre-update Nextcloud backup when required"}
    },
    {
      "id": "mail",
      "version": "1.0.0",
      "group": "communication",
      "displayName": "Mail",
      "description": "Nextcloud Mail gegen einen separat betriebenen mailcow-Upstream-Stack.",
      "type": "external-integration",
      "required": false,
      "defaultState": "not_installed",
      "dependencies": ["nextcloud-core"],
      "conflicts": [],
      "compatibility": {"nextcloud": {"min": "34.0.0", "maxExclusive": "35.0.0"}, "apps": {"schema": "1.x"}, "manifestSchema": "1.0.0"},
      "configuration": {"requirements": [
        {"key": "installed", "type": "boolean", "required": true},
        {"key": "imapReady", "type": "attestation", "required": true},
        {"key": "smtpReady", "type": "attestation", "required": true},
        {"key": "authenticationReady", "type": "attestation", "required": true}
      ]},
      "secrets": {"requirements": [{"id": "mail-account-credentials", "required": true, "source": "Nextcloud user mail-account storage or protected deployment secret"}], "handling": "No mailbox secret is stored or shown by Essentials+ Office."},
      "groups": {"default": ["employee"], "allowed": ["employee", "manager", "hr-admin"], "autoCreate": true},
      "roles": ["admin", "mail-user"],
      "nextcloudApps": [{"id": "mail", "required": true, "source": "app-store", "minVersion": "5.0.0", "maxExclusive": "6.0.0"}],
      "composeServices": [],
      "externalServices": [{"id": "mailcow", "protocols": ["IMAPS", "SMTP submission"], "sharesDatabase": false, "sharesSecrets": false}],
      "jobs": ["Nextcloud cron"],
      "webhooks": [],
      "healthcheck": {"kind": "attestation", "attestationKeys": ["imapReady", "smtpReady", "authenticationReady"], "cacheSeconds": 900, "expectedStatuses": []},
      "dataOwnership": {"owner": "mailcow for mailboxes; Nextcloud Mail for client metadata", "stores": ["separate mailcow storage", "Nextcloud app data"], "sharedDatabase": false},
      "backup": {"boundary": "mailcow and Nextcloud backups remain separate", "includes": ["Nextcloud Mail configuration only in Nextcloud backup"]},
      "restore": {"boundary": "Restore mailcow first, then Nextcloud Mail integration", "preservesDataOnDisable": true},
      "export": {"format": "IMAP", "available": true},
      "activation": {"mode": "admin-center-after-external-health", "requiresHealthy": true, "hostControl": false},
      "deactivation": {"allowed": true, "deletesData": false, "stopsService": false},
      "update": {"policy": "Nextcloud app compatible release; mailcow follows its pinned upstream lifecycle", "rollback": "Independent mailcow and Nextcloud rollback procedures"}
    },
    {
      "id": "vaultwarden",
      "version": "1.0.0",
      "group": "security",
      "displayName": "Vaultwarden",
      "description": "Optionaler webbasierter Passwort-Tresor für Organisationen, Collections, Rollen und Gruppen.",
      "type": "external-service",
      "required": false,
      "defaultState": "not_installed",
      "dependencies": [],
      "conflicts": [],
      "compatibility": {"nextcloud": {"min": "34.0.0", "maxExclusive": "35.0.0"}, "apps": {"schema": "1.x"}, "manifestSchema": "1.0.0"},
      "configuration": {"requirements": [
        {"key": "installed", "type": "boolean", "required": true},
        {"key": "serviceUrl", "type": "https-url", "required": true},
        {"key": "healthUrl", "type": "https-url", "required": true}
      ]},
      "secrets": {"requirements": [{"id": "vaultwarden-environment", "required": true, "source": "mode-0600 env/secret file"}], "handling": "Only a secret-readiness attestation is stored; secret values never enter Nextcloud."},
      "groups": {"default": ["employee"], "allowed": ["employee", "manager", "hr-admin"], "autoCreate": true},
      "roles": ["admin", "organization-owner", "organization-admin", "manager", "user"],
      "nextcloudApps": [],
      "composeServices": ["vaultwarden"],
      "externalServices": [{"id": "vaultwarden", "sharesDatabase": false, "sharesSecrets": false}],
      "jobs": ["Independent Vaultwarden backup"],
      "webhooks": [],
      "healthcheck": {"kind": "https", "endpointConfigurationKey": "healthUrl", "allowedHostSuffixes": [".itmitalles.de", ".internal"], "cacheSeconds": 300, "expectedStatuses": [200]},
      "dataOwnership": {"owner": "Vaultwarden", "stores": ["/srv/vaultwarden/data SQLite and attachments"], "sharedDatabase": false},
      "backup": {"boundary": "Separate encrypted Vaultwarden backup", "includes": ["consistent SQLite snapshot", "attachments", "keys"]},
      "restore": {"boundary": "Empty isolated Vaultwarden target", "preservesDataOnDisable": true},
      "export": {"format": "Vaultwarden/Bitwarden-compatible encrypted or controlled export", "available": true},
      "activation": {"mode": "admin-center-after-compose", "requiresHealthy": true, "hostControl": false},
      "deactivation": {"allowed": true, "deletesData": false, "stopsService": false},
      "update": {"policy": "Exact stable tag and digest after release review", "rollback": "Restore previous image, environment and backup into an empty target"}
    },
    {
      "id": "hr-lite",
      "version": "1.0.0",
      "group": "people-hr",
      "displayName": "HR Lite",
      "description": "Begrenzter synthetischer People-Workflow mit Verzeichnis, On-/Offboarding, Abwesenheiten, Zuständigkeiten und Vorlagen.",
      "type": "nextcloud-workflow",
      "required": false,
      "defaultState": "disabled",
      "dependencies": ["nextcloud-core"],
      "conflicts": [],
      "compatibility": {"nextcloud": {"min": "34.0.0", "maxExclusive": "35.0.0"}, "apps": {"schema": "1.x"}, "manifestSchema": "1.0.0"},
      "configuration": {"requirements": [{"key": "workflowReady", "type": "attestation", "required": true}]},
      "secrets": {"requirements": [], "handling": "Disposable synthetic users use a separate ignored secret file."},
      "groups": {"default": ["hr-admin", "manager", "employee"], "allowed": ["hr-admin", "manager", "employee"], "autoCreate": true},
      "roles": ["hr-admin", "manager", "employee"],
      "nextcloudApps": [
        {"id": "tables", "required": true, "source": "app-store", "minVersion": "2.0.0", "maxExclusive": "3.0.0"},
        {"id": "forms", "required": true, "source": "app-store", "minVersion": "5.0.0", "maxExclusive": "6.0.0", "visibilityMode": "platform-global"},
        {"id": "deck", "required": true, "source": "app-store", "minVersion": "1.0.0", "maxExclusive": "2.0.0"},
        {"id": "calendar", "required": true, "source": "app-store", "minVersion": "6.0.0", "maxExclusive": "8.0.0"},
        {"id": "collectives", "required": true, "source": "app-store", "minVersion": "4.0.0", "maxExclusive": "5.0.0", "visibilityMode": "platform-global"}
      ],
      "composeServices": [],
      "externalServices": [],
      "jobs": ["Nextcloud cron"],
      "webhooks": [],
      "healthcheck": {"kind": "nextcloud-apps-and-attestation", "attestationKeys": ["workflowReady"], "cacheSeconds": 300, "expectedStatuses": []},
      "dataOwnership": {"owner": "Nextcloud", "stores": ["Nextcloud app data", "protected Nextcloud files"], "sharedDatabase": false},
      "backup": {"boundary": "Nextcloud backup", "includes": ["app data", "templates", "protected files", "shares"]},
      "restore": {"boundary": "Nextcloud restore plus target-state verification", "preservesDataOnDisable": true},
      "export": {"format": "Supported Nextcloud app and file exports", "available": true},
      "activation": {"mode": "admin-center-after-synthetic-verification", "requiresHealthy": true, "hostControl": false},
      "deactivation": {"allowed": true, "deletesData": false, "stopsService": false},
      "update": {"policy": "Compatible app releases only", "rollback": "Disable logical activation and restore the pre-update Nextcloud backup if needed"}
    },
    {
      "id": "essentials-calls",
      "version": "1.0.0",
      "group": "integrations",
      "displayName": "Essentials+ Calls",
      "description": "Deaktivierter Integrationsvertrag zu Visual PBX ohne Proxy, Zugangsdaten oder gemeinsame Datenhaltung.",
      "type": "external-integration",
      "required": false,
      "defaultState": "not_installed",
      "dependencies": [],
      "conflicts": [],
      "compatibility": {"nextcloud": {"min": "34.0.0", "maxExclusive": "35.0.0"}, "apps": {"schema": "1.x"}, "manifestSchema": "1.0.0"},
      "configuration": {"requirements": [
        {"key": "installed", "type": "boolean", "required": true},
        {"key": "serviceUrl", "type": "https-url", "required": true},
        {"key": "healthUrl", "type": "https-url", "required": true},
        {"key": "authenticationReady", "type": "attestation", "required": true},
        {"key": "rolesReady", "type": "attestation", "required": true},
        {"key": "sipCredentialStorageReady", "type": "attestation", "required": true},
        {"key": "rightsReady", "type": "attestation", "required": true}
      ]},
      "secrets": {"requirements": [], "handling": "No credentials are accepted in the link or stored by Essentials+ Office."},
      "groups": {"default": ["employee"], "allowed": ["employee", "manager"], "autoCreate": true},
      "roles": ["admin", "user"],
      "nextcloudApps": [],
      "composeServices": [],
      "externalServices": [{"id": "visual-pbx", "repository": "itmitalles-de/visual-pbx", "sharesDatabase": false, "sharesSecrets": false}],
      "jobs": [],
      "webhooks": [],
      "healthcheck": {"kind": "https", "endpointConfigurationKey": "healthUrl", "allowedHostSuffixes": [".itmitalles.de", ".internal"], "cacheSeconds": 300, "expectedStatuses": [200]},
      "dataOwnership": {"owner": "Visual PBX", "stores": ["Separate Visual PBX service"], "sharedDatabase": false},
      "backup": {"boundary": "Visual PBX owns its backup", "includes": []},
      "restore": {"boundary": "Visual PBX owns restore; Office retains only non-secret state", "preservesDataOnDisable": true},
      "export": {"format": "Defined by Visual PBX", "available": false},
      "activation": {"mode": "admin-center-after-release-gates", "requiresHealthy": true, "hostControl": false},
      "deactivation": {"allowed": true, "deletesData": false, "stopsService": false},
      "update": {"policy": "Version contract checked before activation", "rollback": "Hide the tile and restore the prior contract state; never mutate PBX data"}
    }
  ]
}
