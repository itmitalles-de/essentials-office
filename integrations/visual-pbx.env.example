# Visual PBX integration contract. This is read by validation/documentation
# tooling only; it does not create a service, Caddy route, or Nextcloud link.
# Keep disabled until every release gate in docs/integrations/VISUAL_PBX.md is
# proven for the separately operated itmitalles-de/visual-pbx product.
VISUAL_PBX_ENABLED=false
VISUAL_PBX_PORTAL_LABEL=Visual PBX
VISUAL_PBX_PORTAL_URL=
VISUAL_PBX_HEALTH_URL=
# Optional public CA bundle path for a private, configured service. Never point
# this at a private key or client credential.
VISUAL_PBX_CA_FILE=
