# This file is safe to commit. bootstrap.sh creates .env with generated secrets.
# Do not commit .env or put secrets in this repository.

COMPOSE_PROJECT_NAME=nextcloud
PROXY_NETWORK=proxy_net
NEXTCLOUD_DATA_ROOT=/srv/nextcloud

# Stable production names. Disposable tests override these without colliding
# with the running NUC deployment.
DB_CONTAINER_NAME=nextcloud-db
REDIS_CONTAINER_NAME=nextcloud-redis
APP_CONTAINER_NAME=nextcloud-app
CRON_CONTAINER_NAME=nextcloud-cron

NEXTCLOUD_TRUSTED_DOMAINS=cloud.itmitalles.de
NEXTCLOUD_PUBLIC_HOST=cloud.itmitalles.de
TRUSTED_PROXIES=172.18.0.0/16
OVERWRITEPROTOCOL=https
OVERWRITECLIURL=https://cloud.itmitalles.de
TZ=Europe/Berlin

POSTGRES_DB=nextcloud
POSTGRES_USER=nextcloud
POSTGRES_PASSWORD=

NEXTCLOUD_ADMIN_USER=ncadmin
NEXTCLOUD_ADMIN_PASSWORD=

REDIS_PASSWORD=

# Optional Collabora overlay. The WOPI host is a regular-expression hostname.
COLLABORA_PUBLIC_HOST=office.itmitalles.de
COLLABORA_WOPI_HOST=cloud\.itmitalles\.de
# Set explicitly after observing the source address at Nextcloud/Caddy.
COLLABORA_WOPI_ALLOWLIST=
COLLABORA_MEMORY_LIMIT=3g
COLLABORA_CPU_LIMIT=2.0

# Optional TURN overlay. The rendered configuration remains outside Git.
TURN_CONFIG_FILE=/etc/nextcloud/turnserver.conf
