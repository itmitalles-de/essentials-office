# Copy outside Git as .vaultwarden.env (mode 0600), then replace DOMAIN with
# an HTTPS-only private DNS name. This file intentionally contains no secret.
DOMAIN=https://vault.internal.example

# Closed registration is the default. Add users through invitations or through
# an existing organization's Web Vault administration after its first owner has
# been created by the approved onboarding procedure.
SIGNUPS_ALLOWED=false
INVITATIONS_ALLOWED=true
WEBSOCKET_ENABLED=true
LOG_LEVEL=warn

# Optional: enable the global /admin page only with an Argon2 PHC hash generated
# by scripts/vaultwarden-bootstrap.sh --enable-admin. Never use a plaintext
# token, and do not enable the page unless it is operationally needed.
# ADMIN_TOKEN='$argon2id$v=19$m=65540,t=3,p=4$replace$replace'

# Configure SMTP only in the private file when invitation and emergency mail
# delivery are required. mailcow stays a separately managed host/stack.
# SMTP_HOST=mail.example.internal
# SMTP_FROM=vault@example.internal
# SMTP_PORT=587
# SMTP_SECURITY=starttls
# SMTP_USERNAME=
# SMTP_PASSWORD=
