# Copy to /etc/nextcloud/offsite-backup.env as root:root mode 0600.
# This committed file contains paths only, never credentials or repository URLs.

RESTIC_REPOSITORY_FILE=/etc/nextcloud/restic-repository
RESTIC_PASSWORD_FILE=/etc/nextcloud/restic-password

# Required when RESTIC_REPOSITORY_FILE selects an rclone backend. The file may
# contain OAuth refresh tokens and must remain outside Git and logs.
# RCLONE_CONFIG=/etc/nextcloud/rclone.conf

# Optional backend-specific credential files belong outside Git. For example:
# AWS_SHARED_CREDENTIALS_FILE=/etc/nextcloud/restic-aws-credentials
# B2_ACCOUNT_ID_FILE and B2_ACCOUNT_KEY_FILE are not consumed by restic; export
# backend credentials from the protected offsite-backup.env when required.

# Fraction checked after each upload. Set to 100% for a scheduled full check.
RESTIC_READ_DATA_SUBSET=5%
