# Non-secret Essentials+ Office module activation state. Copy to config/office-modules.env
# on the host. false means hidden/inactive; it never removes module data.
OFFICE_MODULE_NEXTCLOUD_CORE_ENABLED=true
OFFICE_MODULE_COLLABORA_ENABLED=false
OFFICE_MODULE_TALK_ENABLED=false
OFFICE_MODULE_MAIL_ENABLED=false
OFFICE_MODULE_INTRANET_LITE_ENABLED=false
OFFICE_MODULE_HR_LITE_ENABLED=false
OFFICE_MODULE_VAULTWARDEN_ENABLED=false
OFFICE_MODULE_VISUAL_PBX_ENABLED=false

# An HTTPS health URL is required before an external module may be made visible
# in the Essentials+ Office Admin Center. URLs may not contain user names, passwords, or
# query strings. Keep them empty until the related service is configured.
OFFICE_MODULE_COLLABORA_HEALTH_URL=
OFFICE_MODULE_TALK_HEALTH_URL=
OFFICE_MODULE_MAIL_HEALTH_URL=
OFFICE_MODULE_VISUAL_PBX_HEALTH_URL=
